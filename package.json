{
  "name": "dsh-trivium",
  "version": "0.7.0",
  "description": "In-process graph memory for DeepSeek Harness, backed by TriviumDB.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/check-integrity.mjs",
    "scripts/clear-expired-until.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-trivium-check": "scripts/check-integrity.mjs",
    "dsh-trivium-clear-until": "scripts/clear-expired-until.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node scripts/run-all.mjs",
    "link-dsh": "node scripts/link-dsh.mjs",
    "smoke-p0": "node scripts/smoke-p0.mjs",
    "smoke-p1": "node scripts/smoke-p1.mjs",
    "smoke-p2": "node scripts/p2-cases.mjs",
    "smoke-p3": "node scripts/smoke-p3.mjs",
    "smoke-p4": "node scripts/smoke-p4.mjs",
    "smoke-p5": "node scripts/smoke-p5.mjs",
    "smoke-p6": "node scripts/smoke-p6.mjs",
    "smoke-p7": "node scripts/smoke-p7.mjs",
    "smoke-p8": "node scripts/smoke-p8.mjs",
    "smoke-p9": "node scripts/smoke-p9.mjs",
    "smoke-p10": "node scripts/smoke-p10.mjs",
    "smoke-p11": "node scripts/smoke-p11.mjs",
    "smoke-p12": "node scripts/smoke-p12.mjs",
    "smoke-p13": "node scripts/smoke-p13.mjs",
    "smoke-p14": "node scripts/smoke-p14.mjs",
    "smoke-p15": "node scripts/smoke-p15.mjs",
    "smoke-p16": "node scripts/smoke-p16.mjs",
    "smoke-p17": "node scripts/smoke-p17.mjs",
    "smoke-p18": "node scripts/smoke-p18.mjs",
    "smoke-p19": "node scripts/smoke-p19.mjs",
    "smoke-p20": "node scripts/smoke-p20.mjs",
    "preuninstall": "node ./lib/purge.js",
    "verify-live-p2": "node scripts/verify-live-p2.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.1.1 || >=0.1.1-rc.2 <0.3.0 || >=0.1.5-rc.1 <0.1.6 || >=0.2.0-rc.0 <0.2.1 || >=0.2.1-rc.0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.1.1 || >=0.1.1-rc.2 <0.3.0 || >=0.1.5-rc.1 <0.1.6 || >=0.2.0-rc.0 <0.2.1 || >=0.2.1-rc.0 <0.3.0"
  },
  "dependencies": {
    "triviumdb": "0.9.0-beta.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "triviumdb",
    "memory",
    "graph",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QWQcool/dsh-trivium.git"
  },
  "bugs": {
    "url": "https://github.com/QWQcool/dsh-trivium/issues"
  },
  "homepage": "https://github.com/QWQcool/dsh-trivium#readme"
}
