{
  "name": "dsh-trivium",
  "version": "0.1.0",
  "description": "In-process graph memory kernel for DeepSeek Harness, backed by TriviumDB.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "link-dsh": "node scripts/link-dsh.mjs",
    "smoke-p0": "node scripts/smoke-p0.mjs",
    "smoke-p1": "node scripts/smoke-p1.mjs",
    "smoke-p2": "node scripts/p2-cases.mjs",
    "smoke-p3": "node scripts/smoke-p3.mjs",
    "smoke-p4": "node scripts/smoke-p4.mjs",
    "smoke-p5": "node scripts/smoke-p5.mjs",
    "verify-live-p2": "node scripts/verify-live-p2.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "dependencies": {
    "triviumdb": "^0.7.4"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "triviumdb",
    "memory",
    "graph",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QWQcool/dsh-trivium.git"
  },
  "bugs": {
    "url": "https://github.com/QWQcool/dsh-trivium/issues"
  },
  "homepage": "https://github.com/QWQcool/dsh-trivium#readme"
}
