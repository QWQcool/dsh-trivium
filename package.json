{
  "name": "dsh-trivium",
  "version": "0.9.1",
  "description": "In-process graph memory for DeepSeek Harness, backed by TriviumDB.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./handoff": "./lib/handoff.js",
    "./documents": "./lib/document-evidence.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/check-integrity.mjs",
    "scripts/clear-expired-until.mjs",
    "scripts/prefs-export.mjs",
    "scripts/query-snapshot.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-trivium-check": "scripts/check-integrity.mjs",
    "dsh-trivium-clear-until": "scripts/clear-expired-until.mjs",
    "dsh-trivium-prefs": "scripts/prefs-export.mjs",
    "dsh-trivium-query": "scripts/query-snapshot.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node scripts/run-all.mjs",
    "test:list": "node scripts/run-all.mjs --list",
    "test:docs": "node scripts/smoke-p91.mjs",
    "link-dsh": "node scripts/link-dsh.mjs",
    "verify-live-p2": "node scripts/verify-live-p2.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.1.1 || >=0.1.1-rc.2 <0.3.0 || >=0.1.5-rc.1 <0.1.6 || >=0.2.0-rc.0 <0.2.1 || >=0.2.1-rc.0 <0.3.0 || >=0.2.2-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.1.1 || >=0.1.1-rc.2 <0.3.0 || >=0.1.5-rc.1 <0.1.6 || >=0.2.0-rc.0 <0.2.1 || >=0.2.1-rc.0 <0.3.0 || >=0.2.2-0 <0.3.0"
  },
  "dependencies": {
    "triviumdb": "0.9.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "triviumdb",
    "memory",
    "graph",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QWQcool/dsh-trivium.git"
  },
  "bugs": {
    "url": "https://github.com/QWQcool/dsh-trivium/issues"
  },
  "homepage": "https://github.com/QWQcool/dsh-trivium#readme",
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "triviumdb-090": "npm:triviumdb@0.9.0"
  }
}
